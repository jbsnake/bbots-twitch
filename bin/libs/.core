# a module name is letters, digits, _ or -, ending in .umod, .amod or .omod
validModule ()  { [[ "$1" =~ ^[A-Za-z0-9_-]+\.[uao]mod$ ]]; }

rebuildModules ()
{
	createANYUSERmodule
	createADMINmodule
	createOWNERmodule
}

# changeTier module newext -> renames a module between .umod, .amod and .omod
changeTier ()
{
	local module="$1" newmod="${1%.*}.$2" dir
	if ! validModule "$module"
	then
		sendMessage "That is not a module name!"
		return
	fi
	if [[ "$newmod" == "$module" ]]
	then
		sendMessage "MODULE: ${module} is already a .$2 module!"
		return
	fi
	for dir in bin/modules bin/inactivemodules
	do
		if [[ -e "${dir}/${module}" ]]
		then
			if [[ -e "${dir}/${newmod}" ]]
			then
				sendMessage "MODULE: ${newmod} already exists!"
				return
			fi
			mv "${dir}/${module}" "${dir}/${newmod}"
			rebuildModules
			sendAction "MODULE: ${module} <<<< converted to >>>> ${newmod}"
			botlog "MODULE: ${module} converted to ${newmod} by ${whoSaid}"
			return
		fi
	done
	sendMessage "MODULE: ${module} does not exist!"
}

#@ owner list | owner add <name> | owner rm <name>
if [[ "$whatSaid" == "${trig}owner "* ]]
then
	rest="${whatSaid#"${trig}owner "}"
	read -r arg1 arg2 _ <<< "${rest,,}"
	arg2="${arg2#@}"
	case "$arg1" in
		list)	sendMessage "*** The current owners of this bot are: $(paste -sd' ' "$owners")"
			;;
		add)	if [[ ! "$arg2" =~ ^[a-z0-9_]{1,25}$ ]]
			then
				sendMessage "*** That is not a Twitch name!"
			elif [[ -n "$(onList "$owners" "$arg2")" ]]
			then
				sendMessage "*** $arg2 is already an owner!"
			else
				add2list "$owners" "$arg2"
				sendMessage "*** Congrats ${arg2}, you are now an owner!"
				botlog "$arg2 added as an owner by $whoSaid"
			fi
			;;
		rm)	if [[ "$arg2" == "$BROADCASTER" ]]
			then
				sendMessage "*** You can't remove $BROADCASTER from the list!"
				botlog "$whoSaid tried to remove $BROADCASTER from the owner list"
			elif rmFromList "$owners" "$arg2"
			then
				sendMessage "*** $arg2 was removed from the owner list!"
				botlog "$whoSaid removed $arg2 from the owner list"
			else
				sendMessage "*** Sorry ${whoSaid}, ${arg2} is not an owner!"
			fi
			;;
		*)	sendMessage "*** That is not an option!"
			;;
	esac
fi

#@ load <module>
if [[ "$whatSaid" == "${trig}load "* ]]
then
	module="${whatSaid#"${trig}load "}"
	if ! validModule "$module"
	then
		response="That is not a module name!"
	elif [[ -e "bin/modules/${module}" ]]
	then
		response="MODULE: ${module} is already loaded!"
	elif [[ ! -e "bin/inactivemodules/${module}" ]]
	then
		response="File: ${module} does not exist!"
	elif ! bash -n "bin/inactivemodules/${module}" 2>/dev/null
	then
		response="MODULE: ${module} has a syntax error and was NOT loaded."
	else
		mv "bin/inactivemodules/${module}" bin/modules/
		rebuildModules
		response="MODULE: ${module} >>>> LOADED."
	fi
	botlog "$response"
	sendAction "$response"
fi # end load

#@ unload <module>
if [[ "$whatSaid" == "${trig}unload "* ]]
then
	module="${whatSaid#"${trig}unload "}"
	if ! validModule "$module"
	then
		response="That is not a module name!"
	elif [[ -e "bin/modules/${module}" ]]
	then
		mv "bin/modules/${module}" bin/inactivemodules/
		rebuildModules
		response="MODULE: ${module} <<<< UNLOADED."
	elif [[ -e "bin/inactivemodules/${module}" ]]
	then
		response="MODULE: ${module} is already unloaded!"
	else
		response="File: ${module} does not exist!"
	fi
	botlog "$response"
	sendAction "$response"
fi # end unload

#@ o2u, u2o, and with the admin tier: o2a, a2o, u2a, a2u  <module>
# The letter after the 2 is the tier the module moves to:
# u = anyone (.umod), a = channel admins (.amod), o = owners (.omod)
if [[ "$whatSaid" =~ ^"${trig}"[uao]2([uao])" "(.+)$ ]]
then
	changeTier "${BASH_REMATCH[2]}" "${BASH_REMATCH[1]}mod"
fi # end tier changes

#@ modules
if [[ "$whatSaid" == "${trig}modules" ]]
then
	daList=""
	for modItem in bin/modules/*.?mod
	do
		[[ -e "$modItem" ]] && daList="${daList} $(getFileName "$modItem"),"
	done
	sendMessage "ACTIVE MODULES: load, unload, u2o, o2u, owner, modules${daList:+,${daList%,}}"
	daList=""
	for modItem in bin/inactivemodules/*.?mod
	do
		[[ -e "$modItem" ]] && daList="${daList} $(getFileName "$modItem"),"
	done
	sendMessage "INACTIVE MODULES:${daList%,}"
fi # end modules
