###############################################################
# DO NOT EDIT THIS FILE UNLESS YOU KNOW WHAT YOU ARE DOING!!! #
###############################################################
#
#    FILE: .admincore
#    bbots (Twitch port) - built-in ADMIN commands (channel level)
#    Sourced on every message from an admin of the channel it came from:
#    the broadcaster, the moderators, anyone on that channel's admin list,
#    and the bot's owners. Nothing here can touch another channel or the
#    module system.
#
#    Copyright (C) 2007 Joshua Bailey and Dave Crouse
#    Licensed under the GNU GPL, version 2 or (at your option) any later version.

#@ admin list | admin add <name> | admin rm <name>
# The list holds extra admins for this channel. Only the broadcaster or an
# owner may change it, so a moderator cannot hand out admin to others.
if [[ "$whatSaid" == "${trig}admin "* ]]
then
	rest="${whatSaid#"${trig}admin "}"
	read -r arg1 arg2 _ <<< "${rest,,}"
	arg2="${arg2#@}"
	case "$arg1" in
		list)	extra=""
			[[ -s "$admins" ]] && extra="$(paste -sd' ' "$admins")"
			sendMessage "*** Admins in ${channel}: the broadcaster, the moderators${extra:+, and: ${extra}}"
			;;
		add|rm)	if [[ "$isOwner" != yes && "$isBroadcaster" != yes ]]
			then
				sendMessage "*** Sorry ${whoSaid}, only the broadcaster can change the admin list"
			elif [[ ! "$arg2" =~ ^[a-z0-9_]{1,25}$ ]]
			then
				sendMessage "*** That is not a Twitch name!"
			elif [[ "$arg1" == "add" ]]
			then
				if [[ -n "$(onList "$admins" "$arg2")" ]]
				then
					sendMessage "*** $arg2 is already an admin here!"
				else
					echo "$arg2" >> "$admins"
					sendMessage "*** ${arg2} is now an admin in ${channel}"
					botlog "$arg2 added as an admin of $channel by $whoSaid"
				fi
			else
				if rmFromList "$admins" "$arg2"
				then
					sendMessage "*** $arg2 is no longer an admin in ${channel}"
					botlog "$whoSaid removed $arg2 as an admin of $channel"
				else
					sendMessage "*** $arg2 is not on the admin list here"
				fi
			fi
			;;
		*)	sendMessage "*** That is not an option!"
			;;
	esac
fi
