#
# botPriv[#channel] is set where the bot is the broadcaster or a moderator
declare -gA botPriv

####################################
#        STRING HELPERS            #
####################################

# inStr needle haystack -> prints the index of the first match, or -1
inStr ()
{
	local searchFor="$1" searchIn="$2" before
	if [[ "$searchIn" == *"$searchFor"* ]]
	then
		before="${searchIn%%"$searchFor"*}"
		echo "${#before}"
	else
		echo "-1"
	fi
}

getFileName ()  { echo "${1##*/}"; }

isNumeric ()    { [[ "$1" =~ ^-?[0-9]+$ ]]; }
isAlpha ()      { [[ "$1" =~ ^[A-Za-z]+$ ]]; }
isAlphaNum ()   { [[ "$1" =~ ^[A-Za-z0-9]+$ ]]; }

# a Twitch channel as IRC names it: # then the lowercase login
validChannel () { [[ "$1" =~ ^#[a-z0-9_]{1,25}$ ]]; }

# randomize max -> prints a number from 1 to max
randomize ()
{
	if [[ ! "$1" =~ ^[0-9]{1,6}$ ]] || (( $1 < 1 ))
	then
		echo 1
		return 1
	fi
	echo $(( RANDOM % $1 + 1 ))
}

####################################
#          LIST HELPERS            #
####################################

# onList file item -> prints the item and returns 0 if it is on the list
onList ()       { [[ -e "$1" ]] && grep -xF -- "$2" "$1"; }

add2list ()
{
	[[ -e "$1" ]] || return 1
	echo "$2" >> "$1"
}

rmFromList ()
{
	local tmp
	[[ -e "$1" ]] || return 1
	onList "$1" "$2" > /dev/null || return 1
	tmp="$(mktemp "${1}.XXXXXX")" || return 1
	grep -vxF -- "$2" "$1" > "$tmp"
	mv "$tmp" "$1"
}

####################################
#            LOGGING               #
####################################

botlog ()       { printf '%(%F %T)T %s\n' -1 "$1" >> logs/botlog; }
channellog ()   { printf '%(%F %T)T %s\n' -1 "$1" >> "logs/${channel:-nochannel}.log"; }

####################################
#       SENDING TO THE SERVER      #
####################################

# sendRaw line -> sends one raw IRC line. Not logged (it carries the token).
sendRaw ()
{
	local line="${1//[$'\r\n']/ }"
	printf '%s\r\n' "$line" >&"${OFD}"
}

sendCom ()
{
	sendRaw "$1 $2"
	botlog "<o> $1 $2"
}

# say where text -> one chat line, trimmed to Twitch's limit and paced.
# Twitch allows far fewer messages where the bot is not a moderator or the
# broadcaster, so those channels get the slower delay.
say ()
{
	local text="$2"
	# a command that came from bin/bbots-ctl answers there, not in chat
	if [[ -n "$consoleReply" ]]
	then
		text="${text//$'\001ACTION '/* }"
		text="${text//$'\001'/}"
		printf '[%s] %s\n' "$1" "$text" >> "$consoleReply"
		return
	fi
	sendRaw "PRIVMSG $1 :${text:0:450}"
	if [[ -n "${botPriv[$1]}" ]]
	then
		sleep "${SEND_DELAY:-0.35}"
	else
		sleep "${SLOW_DELAY:-1.6}"
	fi
}

sendMessage ()  { say "$channel" "${ascii}$1"; }
sendCM ()       { say "$1" "${ascii}$2"; }

# Twitch bots can't whisper over IRC, so a "PM" is an @mention in the channel
sendPM ()       { say "$channel" "${ascii}@$1 $2"; }

sendAction ()   { say "$channel" $'\001'"ACTION $1"$'\001'; }
sendAction2 ()  { say "${2:-$channel}" $'\001'"ACTION $1"$'\001'; }

####################################
#          TWITCH TAGS             #
####################################

# getTag name -> prints the value of one tag from the current line
getTag ()
{
	local t=";${tags};"
	[[ "$t" == *";$1="* ]] || return 1
	t="${t#*";$1="}"
	echo "${t%%;*}"
}

####################################
#         MODULE BUILDING          #
####################################

# Active modules are joined into one file per tier, and the bot sources
# those files on every message. That is what makes loading and unloading
# take effect without a restart.
buildModuleFile ()
{
	local ext="$1" out="$2" f tmp
	tmp="$(mktemp "${out}.XXXXXX")" || return 1
	{
		echo "######### This is an auto-generated file #########"
		echo "######### Created by the bbots program. DO NOT EDIT THIS FILE MANUALLY"
		echo
		for f in bin/modules/*."$ext"
		do
			[[ -e "$f" ]] || continue
			cat "$f"
			echo
			echo
		done
	} > "$tmp"
	mv "$tmp" "$out"
}

# three tiers: .omod owners only, .amod channel admins, .umod anyone
createOWNERmodule ()    { buildModuleFile omod bin/owner-modules; }
createADMINmodule ()    { buildModuleFile amod bin/admin-modules; }
createANYUSERmodule ()  { buildModuleFile umod bin/anyuser-modules; }
